{
       "compilerOptions": {
         "target": "ES2022",
         "module": "NodeNext",
         "moduleResolution": "NodeNext",
         "rootDir": ".",
         "outDir": "dist",
         "strict": true,
         "noUncheckedIndexedAccess": true,
         "esModuleInterop": true,
         "forceConsistentCasingInFileNames": true,
         "skipLibCheck": true,
         "resolveJsonModule": true,
         "declaration": true,
         "sourceMap": true,
         "jsx": "react-jsx"
       },
       "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
       "exclude": [
         "dist",
         "build",
         "node_modules",
         "scripts/**/*.jsx"
       ],
       "types" : ["node"]
     }
